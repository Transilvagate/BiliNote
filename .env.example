# 通用端口配置
BACKEND_PORT=8483 # 后端端口
FRONTEND_PORT=3015
BACKEND_HOST=0.0.0.0 # 默认为 0.0.0.0，表示监听所有 IP 地址 不建议动
APP_PORT= 3015 # docker 部署时用
APP_BIND_HOST=127.0.0.1 # docker 默认仅本机可访问，远程访问改为 0.0.0.0
# 前端访问后端用 (开发环境使用)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SCREENSHOT_BASE_URL=http://127.0.0.1:8483/static/screenshots
VITE_FRONTEND_PORT=3015
# 生产环境配置
ENV=production
STATIC=/static
OUT_DIR=./static/screenshots
NOTE_OUTPUT_DIR=note_results
IMAGE_BASE_URL=/static/screenshots
DATA_DIR=data
# FFMPEG 配置
FFMPEG_BIN_PATH=

# transcriber 相关配置
TRANSCRIBER_TYPE=fast-whisper # fast-whisper/bcut/kuaishou/mlx-whisper(仅Apple平台)/groq
WHISPER_MODEL_SIZE=medium
BILIBILI_COOKIES_FILE=config/bilibili.cookies.txt # B站 Cookie 文件（通过 BBDown login 生成）
BILIBILI_SUBTITLE_PROVIDER=bbdown # B站字幕提供方，默认使用 BBDown
BBDOWN_BIN=/usr/local/bin/BBDown # BBDown 可执行文件路径
BBDOWN_WORK_DIR=data/bbdown # BBDown 字幕下载工作目录
BBDOWN_TIMEOUT_SECONDS=120 # BBDown 执行超时时间（秒）
COOKIE_SECURITY_LOCAL_ONLY=true # 是否仅允许本机访问 Cookie 敏感接口
CONFIG_ADMIN_TOKEN= # 可选：配置后需在请求头 X-BiliNote-Admin-Token 携带相同令牌
MODEL_CONTEXT_LIMIT_DEFAULT=32000
MODEL_CONTEXT_LIMIT_OVERRIDES={"gpt-4o-mini":128000,"deepseek-chat":64000}
FORMAL_TRANSCRIPT_OUTPUT_RESERVE=4000
FORMAL_TRANSCRIPT_CHUNK_TARGET=6000
FORMAL_TRANSCRIPT_MERGE_TARGET=8000

GROQ_TRANSCRIBER_MODEL=whisper-large-v3-turbo # groq提供的faster-whisper 默认为 whisper-large-v3-turbo
