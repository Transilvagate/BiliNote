FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

ARG BBDOWN_DOWNLOAD_URL=https://github.com/nilaoda/BBDown/releases/download/1.6.3/BBDown_1.6.3_20240814_linux-x64.zip

RUN apt-get update && \
    apt-get install -y ffmpeg python3-pip curl ca-certificates unzip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 安装 BBDown（B站字幕下载）
RUN set -eux; \
    curl -fL "${BBDOWN_DOWNLOAD_URL}" -o /tmp/bbdown.zip; \
    unzip -o /tmp/bbdown.zip -d /tmp/bbdown; \
    bbdown_bin="$(find /tmp/bbdown -type f -name BBDown | head -n1)"; \
    test -n "${bbdown_bin}"; \
    install -m 0755 "${bbdown_bin}" /usr/local/bin/BBDown; \
    rm -rf /tmp/bbdown /tmp/bbdown.zip; \
    test -x /usr/local/bin/BBDown

ENV PATH="/usr/local/bin:/usr/bin:${PATH}"

# HuggingFace 国内镜像
ENV HF_ENDPOINT=https://hf-mirror.com

# BBDown 相关配置
ENV BBDOWN_BIN=/usr/local/bin/BBDown
ENV BBDOWN_WORK_DIR=data/bbdown
ENV BBDOWN_TIMEOUT_SECONDS=120
ENV BILIBILI_SUBTITLE_PROVIDER=bbdown

WORKDIR /app
COPY ./backend /app

# 安装项目依赖（不含 torch）
RUN pip install --no-cache-dir -i https://pypi.mirrors.ustc.edu.cn/simple -r requirements.txt

# 安装 CUDA 版 torch（cu124 wheel 向后兼容 CUDA 12.8 runtime）
# 必须在 transformers 之前安装，否则 pip 会拉取 CPU 版 torch
RUN pip install --no-cache-dir torch \
    --extra-index-url https://download.pytorch.org/whl/cu124

# 升级 ctranslate2 至 4.7.1+（修复 Blackwell sm_120 上的 CUDA kernel 崩溃问题）
RUN pip install --no-cache-dir -i https://pypi.mirrors.ustc.edu.cn/simple 'ctranslate2>=4.7.1'

# 安装 transformers（torch 已就位，不会重复安装 CPU 版）
RUN pip install --no-cache-dir -i https://pypi.mirrors.ustc.edu.cn/simple 'transformers>=4.23'

CMD ["python3", "main.py"]
