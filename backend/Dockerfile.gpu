FROM m.daocloud.io/docker.io/nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

# BBDown 下载地址：使用 ghfast.top 代理访问 GitHub Release
# 若代理不可用可在构建时覆盖：--build-arg BBDOWN_DOWNLOAD_URL=<url>
ARG BBDOWN_DOWNLOAD_URL=https://ghfast.top/https://github.com/nilaoda/BBDown/releases/download/1.6.3/BBDown_1.6.3_20240814_linux-x64.zip

# 替换为清华 Ubuntu 22.04 (jammy) 镜像源
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y ffmpeg python3-pip curl ca-certificates unzip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 安装 BBDown（B站字幕下载）
RUN set -eux; \
    curl -fL "${BBDOWN_DOWNLOAD_URL}" -o /tmp/bbdown.zip; \
    unzip -o /tmp/bbdown.zip -d /tmp/bbdown; \
    bbdown_bin="$(find /tmp/bbdown -type f -name BBDown | head -n1)"; \
    test -n "${bbdown_bin}"; \
    install -m 0755 "${bbdown_bin}" /usr/local/bin/BBDown; \
    rm -rf /tmp/bbdown /tmp/bbdown.zip; \
    test -x /usr/local/bin/BBDown

ENV PATH="/usr/local/bin:/usr/bin:${PATH}"

# HuggingFace 国内镜像
ENV HF_ENDPOINT=https://hf-mirror.com

# BBDown 相关配置
ENV BBDOWN_BIN=/usr/local/bin/BBDown
ENV BBDOWN_WORK_DIR=data/bbdown
ENV BBDOWN_TIMEOUT_SECONDS=120
ENV BILIBILI_SUBTITLE_PROVIDER=bbdown

WORKDIR /app
COPY ./backend /app

# 安装项目依赖（不含 torch）
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt

# 安装 CUDA 版 torch（使用上海交大 PyTorch wheel 镜像，cu124 兼容 CUDA 12.8 runtime）
# 必须在 transformers 之前安装，否则 pip 会拉取 CPU 版 torch
RUN pip install --no-cache-dir torch \
    --index-url https://mirror.sjtu.edu.cn/pytorch-wheels/cu124/

# 升级 ctranslate2 至 4.7.1+（修复 Blackwell sm_120 上的 CUDA kernel 崩溃问题）
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple 'ctranslate2>=4.7.1'

# 安装 transformers（torch 已就位，不会重复安装 CPU 版）
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple 'transformers>=4.23'

CMD ["python3", "main.py"]
