FROM m.daocloud.io/docker.io/nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
ARG BBDOWN_DOWNLOAD_URL=https://ghfast.top/https://github.com/nilaoda/BBDown/releases/download/1.6.3/BBDown_1.6.3_20240814_linux-x64.zip

RUN rm -f /etc/apt/sources.list && \
    rm -rf /etc/apt/sources.list.d/* && \
    echo "deb https://${APT_MIRROR}/ubuntu jammy main restricted universe multiverse" > /etc/apt/sources.list && \
    echo "deb https://${APT_MIRROR}/ubuntu jammy-updates main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb https://${APT_MIRROR}/ubuntu jammy-security main restricted universe multiverse" >> /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg python3-pip curl ca-certificates unzip && \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    curl -fL "${BBDOWN_DOWNLOAD_URL}" -o /tmp/bbdown.zip; \
    unzip -o /tmp/bbdown.zip -d /tmp/bbdown; \
    bbdown_bin="$(find /tmp/bbdown -type f -name BBDown | head -n1)"; \
    test -n "${bbdown_bin}"; \
    install -m 0755 "${bbdown_bin}" /usr/local/bin/BBDown; \
    rm -rf /tmp/bbdown /tmp/bbdown.zip; \
    test -x /usr/local/bin/BBDown

ENV PATH="/usr/local/bin:/usr/bin:${PATH}"
ENV HF_ENDPOINT=https://hf-mirror.com

# BBDown 相关配置
ENV BBDOWN_BIN=/usr/local/bin/BBDown
ENV BBDOWN_WORK_DIR=data/bbdown
ENV BBDOWN_TIMEOUT_SECONDS=120
ENV BILIBILI_SUBTITLE_PROVIDER=bbdown

WORKDIR /app

# 先复制 requirements.txt 利用层缓存
COPY ./backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -i ${PIP_INDEX} -r requirements.txt && \
    pip install --no-cache-dir torch --index-url https://mirror.sjtu.edu.cn/pytorch-wheels/cu124/ && \
    pip install --no-cache-dir -i ${PIP_INDEX} 'ctranslate2>=4.7.1' && \
    pip install --no-cache-dir -i ${PIP_INDEX} 'transformers>=4.23'

# 再复制应用代码
COPY ./backend /app

CMD ["python3", "main.py"]
